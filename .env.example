# ─────────────────────────────────────────────────────────────────────────────
# .env.example  –  Copy to .env and fill in real values.
# Never commit your actual .env file.
# ─────────────────────────────────────────────────────────────────────────────

# WhatsApp (Green API) — free tier: https://green-api.com
GOLD_PHONE_NUMBER=91XXXXXXXXXX@c.us       # recipient phone in international format
GREEN_API_INSTANCE=71XXXXXXXX             # your Green API instance ID
GREEN_API_TOKEN=your_green_api_token_here
GREEN_API_URL=https://7107.api.greenapi.com  # adjust to your instance region

# Optional: Exchange-rate API key (open.er-api.com free tier)
# If unset the script still works via yfinance USDINR=X ticker.
# ER_API_KEY=your_er_api_key_here

# Optional: Outbound HTTP proxy
# Required on PythonAnywhere free tier - uncomment the line below:
# HTTPS_PROXY=http://proxy.server:3128
# HTTP_PROXY=http://proxy.server:3128
